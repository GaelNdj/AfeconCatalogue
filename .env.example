# Sécurité admin (obligatoire en prod)
ADMIN_API_KEY=changez-moi-en-production
FRONTEND_URL=http://localhost:5173

# Sessions clients (devis / compte) — min. 32 caractères en production
SESSION_SECRET=changez-moi-session-secret-long-en-production

# Dossiers autorisés pour import images serveur (séparés par virgule)
IMAGES_IMPORT_DIR=/Users/gael/Desktop/catalogue_pro_2026_images

DATABASE_URL=postgresql://gael@localhost:5432/afecon_catalogue
PORT=4000
UPLOAD_DIR=./uploads

# Conversion affichage visiteur (prix catalogue reste en EUR en base)
EUR_TO_CDF=2850
EUR_TO_USD=1.08

# Contact — adresse qui reçoit les demandes « pièce introuvable »
CONTACT_TO_EMAIL=votre-adresse@exemple.fr

# Commandes — notification admin (défaut : CONTACT_TO_EMAIL)
ORDERS_TO_EMAIL=votre-adresse@exemple.fr

# Paiement Stripe (Checkout — carte bancaire)
# Clés test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook local : stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP (envoi des e-mails de contact)
# Exemple Gmail : smtp.gmail.com / port 587 + mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM="AfeconCatalogue" <votre-adresse@gmail.com>
